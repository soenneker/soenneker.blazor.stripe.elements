@using System.Threading
@using Microsoft.JSInterop
@using Soenneker.Blazor.Extensions.EventCallback
@using Soenneker.Blazor.Stripe.Elements.Abstract
@using Soenneker.Blazor.Stripe.Elements.Configuration
@using Soenneker.Blazor.Stripe.Elements.Dtos
@using Soenneker.Extensions.CancellationTokens
@using Soenneker.Extensions.String
@using Soenneker.Blazor.Utils.Ids
@using Soenneker.Blazor.Stripe.Elements.Configuration.Checkout
@using Soenneker.Blazor.Stripe.Elements.Configuration.Card

@inject IStripeElementsInterop StripeElementsInterop

@inherits Soenneker.Lepton.Suite.LeptonCancellableIdentifiableContentElement
@implements IStripeElements

<div id="@Id" @attributes="EffectiveAttributes">
    <CascadingValue Value="ElementIds" >
        @ChildContent
    </CascadingValue>
</div>

@code {

    [Parameter]
    public EventCallback OnInitialize { get; set; }

    [Parameter]
    public EventCallback OnElementRendered { get; set; }

    [Parameter]
    public EventCallback OnPaymentElementReady { get; set; }

    [Parameter]
    public EventCallback OnCardElementReady { get; set; }

    [Parameter]
    public EventCallback<StripeCardElementChangeResult> OnCardElementChange { get; set; }

    [Parameter]
    public EventCallback OnAddressElementReady { get; set; }

    [Parameter]
    public EventCallback OnLinkAuthenticationElementReady { get; set; }

    [Parameter]
    public EventCallback OnContactDetailsElementReady { get; set; }

    [Parameter]
    public EventCallback<StripeSubmitResult?> OnAfterSubmit { get; set; }

    [Parameter]
    public EventCallback<StripeConfirmResult?> OnAfterConfirmPayment { get; set; }

    [Parameter]
    public EventCallback<StripeConfirmResult?> OnAfterConfirmSetup { get; set; }

    [Parameter]
    public EventCallback<StripeConfirmResult?> OnAfterConfirmCheckout { get; set; }
    public StripeElements()
    {
        Id = BlazorIdGenerator.New("stripe-elements");
    }

    private DotNetObjectReference<StripeElements>? _dotNetReference;

    [Parameter]
    public StripeElementsConfiguration? Configuration { get; set; }

    [Parameter]
    public bool Log { get; set; }

    [Parameter]
    public bool ManuallyInitialize { get; set; }

    public Dictionary<Type, string> ElementIds { get; set; } = new()
    {
        {typeof(StripeAddressElement), BlazorIdGenerator.New("stripe-address")},
        {typeof(StripeContactDetailsElement), BlazorIdGenerator.New("stripe-contact-details")},
        {typeof(StripeLinkAuthenticationElement), BlazorIdGenerator.New("stripe-link-auth")},
        {typeof(StripePaymentElement), BlazorIdGenerator.New("stripe-payment")},
        {typeof(StripeCardElement), BlazorIdGenerator.New("stripe-card")}
    };

    private bool _initialized;
    private bool _createCalled;
    private bool _interopInitialized;
    private bool _elementRenderHandled;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (!firstRender && _elementRenderHandled)
            return;

        if (!_interopInitialized)
        {
            await StripeElementsInterop.Initialize(CancellationToken);
            _interopInitialized = true;
        }

        if (_elementRenderHandled)
            return;

        _elementRenderHandled = true;

        await OnElementRendered.InvokeIfHasDelegate();

        if (!ManuallyInitialize)
            await Initialize();
    }

    public async ValueTask LoadStripe(CancellationToken cancellationToken = default)
    {
        CancellationToken linked = CancellationToken.Link(cancellationToken, out CancellationTokenSource? cts);

        using (cts)
            await StripeElementsInterop.LoadStripe(linked);
    }

    public async ValueTask Initialize(StripeElementsConfiguration? configuration = null, CancellationToken cancellationToken = default)
    {
        if (_createCalled)
            throw new InvalidOperationException("StripeElements has already been Initialized");

        if (!_interopInitialized)
            throw new InvalidOperationException("Stripe Elements interop is not yet available. Wait until the component has rendered.");

        StripeElementsConfiguration? effectiveConfiguration = configuration ?? Configuration;

        if (effectiveConfiguration == null)
            throw new InvalidOperationException("StripeElements Configuration must be set");

        if (string.IsNullOrWhiteSpace(effectiveConfiguration.PublishableKey))
            throw new InvalidOperationException("A Stripe publishable key is required.");

        if (effectiveConfiguration.PublishableKey.StartsWith("sk_", StringComparison.OrdinalIgnoreCase) ||
            effectiveConfiguration.PublishableKey.StartsWith("rk_", StringComparison.OrdinalIgnoreCase))
            throw new InvalidOperationException("A Stripe secret or restricted key must never be sent to the browser. Use a publishable key.");

        Configuration = effectiveConfiguration;
        Configuration.AddressElementId ??= ElementIds[typeof(StripeAddressElement)];
        Configuration.ContactDetailsElementId ??= ElementIds[typeof(StripeContactDetailsElement)];
        Configuration.LinkAuthenticationElementId ??= ElementIds[typeof(StripeLinkAuthenticationElement)];
        Configuration.PaymentElementId ??= ElementIds[typeof(StripePaymentElement)];
        Configuration.CardElementId ??= ElementIds[typeof(StripeCardElement)];

        _createCalled = true;
        _initialized = true;

        _dotNetReference = DotNetObjectReference.Create(this);

        CancellationToken linked = CancellationToken.Link(cancellationToken, out CancellationTokenSource? cts);

        try
        {
            using (cts)
            {
                await StripeElementsInterop.Create(Id!, _dotNetReference, Configuration, linked);
                await StripeElementsInterop.CreateObserver(Id!, linked);
            }
        }
        catch
        {
            try
            {
                await StripeElementsInterop.Unmount(Id!);
            }
            catch
            {
                // Preserve the initialization exception; browser cleanup is best effort on this path.
            }

            _dotNetReference.Dispose();
            _dotNetReference = null;
            _createCalled = false;
            _initialized = false;
            throw;
        }
    }

    public async ValueTask<StripeConfirmResult?> ConfirmPayment(string returnUrl, string? paymentIntentClientSecret = null, CancellationToken cancellationToken = default)
    {
        if (!_initialized)
            throw new InvalidOperationException("Stripe Elements has not been initialized yet.");

        if (Configuration?.CheckoutSessionOptions != null)
            return await ConfirmCheckout(cancellationToken: cancellationToken);

        paymentIntentClientSecret ??= Configuration?.ElementsOptions?.ClientSecret;

        if (paymentIntentClientSecret.IsNullOrWhiteSpace())
            throw new InvalidOperationException("PaymentIntent client secret is missing.");

        CancellationToken linked = CancellationToken.Link(cancellationToken, out CancellationTokenSource? cts);

        using (cts)
        {
            StripeConfirmResult? result = await StripeElementsInterop.ConfirmPayment(Id!, paymentIntentClientSecret, returnUrl, linked);
            await OnAfterConfirmPayment.InvokeIfHasDelegate(result);
            return result;
        }
    }

    public async ValueTask<StripeConfirmResult?> ConfirmSetup(string returnUrl, string? setupIntentClientSecret = null, CancellationToken cancellationToken = default)
    {
        if (!_initialized)
            throw new InvalidOperationException("Stripe Elements has not been initialized yet.");

        if (Configuration?.CheckoutSessionOptions != null)
            return await ConfirmCheckout(cancellationToken: cancellationToken);

        setupIntentClientSecret ??= Configuration?.ElementsOptions?.ClientSecret;

        if (setupIntentClientSecret.IsNullOrWhiteSpace())
            throw new InvalidOperationException("SetupIntent client secret is missing.");

        CancellationToken linked = CancellationToken.Link(cancellationToken, out CancellationTokenSource? cts);

        using (cts)
        {
            StripeConfirmResult? result = await StripeElementsInterop.ConfirmSetup(Id!, setupIntentClientSecret, returnUrl, linked);
            await OnAfterConfirmSetup.InvokeIfHasDelegate(result);
            return result;
        }
    }

    public async ValueTask<StripeSubmitResult?> Submit(CancellationToken cancellationToken = default)
    {
        if (!_initialized)
            throw new InvalidOperationException("Stripe Elements has not been initialized yet.");

        CancellationToken linked = CancellationToken.Link(cancellationToken, out CancellationTokenSource? cts);

        using (cts)
        {
            StripeSubmitResult? result = await StripeElementsInterop.Submit(Id!, linked);
            await OnAfterSubmit.InvokeIfHasDelegate(result);
            return result;
        }
    }

    public async ValueTask<StripeConfirmResult?> ConfirmCardPayment(string paymentIntentClientSecret, StripeCardBillingDetails? billingDetails = null,
        CancellationToken cancellationToken = default)
    {
        if (!_initialized)
            throw new InvalidOperationException("Stripe Elements has not been initialized yet.");

        CancellationToken linked = CancellationToken.Link(cancellationToken, out CancellationTokenSource? cts);

        using (cts)
        {
            StripeConfirmResult? result = await StripeElementsInterop.ConfirmCardPayment(Id!, paymentIntentClientSecret, billingDetails, linked);
            await OnAfterConfirmPayment.InvokeIfHasDelegate(result);
            return result;
        }
    }

    public async ValueTask<StripeConfirmResult?> ConfirmCardSetup(string setupIntentClientSecret, StripeCardBillingDetails? billingDetails = null,
        CancellationToken cancellationToken = default)
    {
        if (!_initialized)
            throw new InvalidOperationException("Stripe Elements has not been initialized yet.");

        CancellationToken linked = CancellationToken.Link(cancellationToken, out CancellationTokenSource? cts);

        using (cts)
        {
            StripeConfirmResult? result = await StripeElementsInterop.ConfirmCardSetup(Id!, setupIntentClientSecret, billingDetails, linked);
            await OnAfterConfirmSetup.InvokeIfHasDelegate(result);
            return result;
        }
    }

    public async ValueTask<StripeConfirmResult?> ConfirmCheckout(string? returnUrl = null, StripeCheckoutConfirmOptions? options = null, CancellationToken cancellationToken = default)
    {
        if (!_initialized)
            throw new InvalidOperationException("Stripe Elements has not been initialized yet.");

        if (Configuration?.CheckoutSessionOptions == null)
            throw new InvalidOperationException("CheckoutSessionOptions must be set to confirm a Checkout Session.");

        CancellationToken linked = CancellationToken.Link(cancellationToken, out CancellationTokenSource? cts);

        using (cts)
        {
            StripeConfirmResult? result = await StripeElementsInterop.ConfirmCheckout(Id!, returnUrl, options, linked);
            await OnAfterConfirmCheckout.InvokeIfHasDelegate(result);
            return result;
        }
    }

    public async ValueTask Update(CancellationToken cancellationToken = default)
    {
        if (!_initialized)
            throw new InvalidOperationException("Stripe Elements has not been initialized yet.");

        CancellationToken linked = CancellationToken.Link(cancellationToken, out CancellationTokenSource? cts);

        using (cts)
            await StripeElementsInterop.Update(Id!, linked);
    }

    public async ValueTask Unmount(CancellationToken cancellationToken = default)
    {
        if (!_initialized)
            throw new InvalidOperationException("Stripe Elements has not been initialized yet.");

        CancellationToken linked = CancellationToken.Link(cancellationToken, out CancellationTokenSource? cts);

        using (cts)
            await StripeElementsInterop.Unmount(Id!, linked);

        _dotNetReference?.Dispose();
        _dotNetReference = null;
        _initialized = false;
        _createCalled = false;
    }

    [JSInvokable("OnInitializedJs")]
    public Task OnInitializedJs()
    {
        return OnInitialize.InvokeIfHasDelegate();
    }

    [JSInvokable("OnPaymentElementReadyJs")]
    public Task OnPaymentElementReadyJs()
    {
        return OnPaymentElementReady.InvokeIfHasDelegate();
    }

    [JSInvokable("OnAddressElementReadyJs")]
    public Task OnAddressElementReadyJs()
    {
        return OnAddressElementReady.InvokeIfHasDelegate();
    }

    [JSInvokable("OnLinkAuthenticationElementReadyJs")]
    public Task OnLinkAuthenticationElementReadyJs()
    {
        return OnLinkAuthenticationElementReady.InvokeIfHasDelegate();
    }

    [JSInvokable("OnCardElementReadyJs")]
    public Task OnCardElementReadyJs()
    {
        return OnCardElementReady.InvokeIfHasDelegate();
    }

    [JSInvokable("OnCardElementChangeJs")]
    public Task OnCardElementChangeJs(StripeCardElementChangeResult result)
    {
        return OnCardElementChange.InvokeIfHasDelegate(result);
    }

    [JSInvokable("OnContactDetailsElementReadyJs")]
    public Task OnContactDetailsElementReadyJs()
    {
        return OnContactDetailsElementReady.InvokeIfHasDelegate();
    }

    public override async ValueTask DisposeAsync()
    {
        if (_initialized && Id is not null)
        {
            try
            {
                await StripeElementsInterop.Unmount(Id);
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _dotNetReference?.Dispose();
        _dotNetReference = null;
        _initialized = false;
        _createCalled = false;

        await base.DisposeAsync();
    }

}
